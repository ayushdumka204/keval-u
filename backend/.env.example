# Copy this file to backend/.env and replace every YOUR_* placeholder.
# Never commit backend/.env.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://YOUR_MONGODB_USERNAME:YOUR_MONGODB_PASSWORD@YOUR_CLUSTER_HOST/keval?retryWrites=true&w=majority
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_TEST_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_SEPARATE_WEBHOOK_SECRET
PAYMENT_AMOUNT_PAISE=50000
PAYMENT_CURRENCY=INR
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD_OR_APP_PASSWORD
SMTP_SECURE=false
NOTIFY_EMAIL=owner@example.com
MAIL_FROM=KEVAL <no-reply@example.com>
ADMIN_AUTH_SECRET=YOUR_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
